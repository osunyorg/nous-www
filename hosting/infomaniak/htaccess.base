# Apache configuration for the Infomaniak web hosting.
# public/.htaccess is GENERATED by hosting/infomaniak/build.js:
# this file + the redirects of deuxfleurs.toml (managed by Osuny). Edit this file, not public/.htaccess.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (also behind the Cloudflare proxy, "orange cloud")
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # TODO: choose the main domain, then uncomment (here: www -> bare domain)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers (same as netlify.toml)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Cache
  # Pages and data: always checked again (changes are visible right after a deploy)
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS / CSS without a fingerprint in the name (e.g. /js/hr-map.js, pagefind):
  # checked again each time, so no more "?v=…" to bump in Osuny
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS / CSS fingerprinted by Hugo (main.<hash>.js): never change, cached 1 year
  <FilesMatch "\.[0-9a-f]{32,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts and images: 1 year (same as deuxfleurs.toml)
  <FilesMatch "\.(woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
