# Instance Osuny (sans le scheme)
OSUNY_API_HOST=nous.osuny.org
# Jeton secret de l'app créée dans l'admin (/admin/directory/apps), affiché une seule fois.
# Ne jamais commiter la valeur réelle (.env est gitignoré).
OSUNY_API_TOKEN=
# Site nous-www (trouvé via GET /api/osuny/v1/communication/websites)
OSUNY_WEBSITE_ID=072641b5-6716-49b3-8c74-b761bc68f78b
